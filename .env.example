# Copy this file to .env, then fill in LLM_PROVIDER and LLM_API_KEY.
# Never share or commit your .env file!
# Edit it any time: the running app and notebooks use the new values on the next question, no restart needed.

# Which LLM is the senior expert: openai, anthropic, gemini or ollama
LLM_PROVIDER=openai

# The key for that provider (the same setting name for every provider):
#   openai:    sk-proj-...   https://platform.openai.com/api-keys
#   anthropic: sk-ant-...    https://console.anthropic.com/
#   gemini:    AIza...       https://aistudio.google.com/apikey (free tier)
#   ollama:    leave empty   (free model on your laptop)
# No key at all? Saved answers still replay for free, new questions go to Ollama,
# and new actions like refunds are handed to a human (they need a cloud key).
LLM_API_KEY=

# on  = questions asked before are answered from saved answers: instant, free, works offline (the default)
# off = every question goes to the LLM live (needs a real key, costs a little). Use it to test your key.
REPLAY=on

# Optional: a different model for the provider above
# (defaults: openai gpt-5.4-mini, anthropic claude-opus-5-5, gemini gemini-3.8-flash, ollama llama3.2:3b)
# Saved answers were made with openai gpt-5.4-mini, so other choices ask the LLM live the first time.
# LLM_MODEL=

# Optional: the junior assistant's model in Ollama, and where Ollama runs (normally found by itself, also from Docker)
# LOCAL_MODEL=llama3.2:3b
# OLLAMA_URL=http://localhost:11434
