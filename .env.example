# Copy this file to .env, then fill in ONE key (whichever you have).
# Never share or commit your .env file!

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=          # free tier: https://aistudio.google.com/apikey

# No key at all? Leave them all empty. The project then uses a free model on your laptop (Ollama).

# Optional: force a provider (openai, anthropic, gemini, ollama) when you have more than one key
# LLM_PROVIDER=openai

# Optional: change the models
# OPENAI_MODEL=gpt-6.1-sol
# ANTHROPIC_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash
# LOCAL_MODEL=llama3.2:3b
